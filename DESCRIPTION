Type: Package
Package: PFclassify
Title: Protein Food (PF) Groups Classification for USDA Food Codes
Version: 0.1.0
Authors@R: c(
    person("Yongyi", "Pan", , "Yongyi.Pan@tufts.edu", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0005-7490-6993")),
